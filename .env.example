# ---------------------------------------------------------------------------
# Banco — PostgreSQL via Supabase
# ---------------------------------------------------------------------------
# Use a connection string do Supabase. Para o connection pooler em modo
# transaction, a porta é 6543 (lib/db.ts já usa prepare:false). Para conexão
# direta, porta 5432.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase (cliente / realtime) — opcional nesta fase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Analytics — PostHog (NUNCA enviar PII: e-mail, whatsapp, nome, texto livre)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
